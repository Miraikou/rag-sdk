{
  "name": "rag-sdk-monorepo",
  "private": true,
  "description": "通用、模块化、可扩展的 TypeScript RAG SDK",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "test": "vitest",
    "test:run": "vitest run",
    "test:unit": "vitest run packages/*/__tests__",
    "test:e2e": "vitest run tests/",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "prettier --write \"packages/*/src/**/*.ts\"",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean"
  },
  "keywords": [
    "rag",
    "llm",
    "embedding",
    "vector-search",
    "knowledge-base",
    "ai"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.17.0",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "prettier": "^3.2.0",
    "tsup": "^8.0.0",
    "turbo": "^2.0.0",
    "typescript": "^6.0.3",
    "vitest": "^1.6.0"
  }
}
