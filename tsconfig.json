{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "ESNext.Intl"],
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,

    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@rag-sdk/core": ["packages/core/src"],
      "@rag-sdk/llm": ["packages/llm/src"],
      "@rag-sdk/embedding": ["packages/embedding/src"],
      "@rag-sdk/storage": ["packages/storage/src"],
      "@rag-sdk/document": ["packages/document/src"],
      "@rag-sdk/retrieval": ["packages/retrieval/src"],
      "@rag-sdk/generation": ["packages/generation/src"],
      "@rag-sdk/indexing": ["packages/indexing/src"],
      "@rag-sdk/evaluation": ["packages/evaluation/src"],
      "@rag-sdk/knowledge-graph": ["packages/knowledge-graph/src"],
      "@rag-sdk/llm-anthropic": ["packages/llm-anthropic/src"],
      "@rag-sdk/llm-google": ["packages/llm-google/src"],
      "@rag-sdk/embedding-anthropic": ["packages/embedding-anthropic/src"],
      "@rag-sdk/embedding-google": ["packages/embedding-google/src"],
      "@rag-sdk/embedding-voyage": ["packages/embedding-voyage/src"],
      "@rag-sdk/storage-pinecone": ["packages/storage-pinecone/src"],
      "@rag-sdk/storage-weaviate": ["packages/storage-weaviate/src"],
      "@rag-sdk/storage-chroma": ["packages/storage-chroma/src"],
      "@rag-sdk/storage-qdrant": ["packages/storage-qdrant/src"],
      "@rag-sdk/storage-pgvector": ["packages/storage-pgvector/src"],
      "rag-sdk": ["packages/rag-sdk/src"]
    },
    "types": ["node"]
  },
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts", "**/demo/**"]
}
