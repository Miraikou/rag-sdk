{
  "name": "@rag-sdk/document",
  "description": "文档处理模块，提供切块、加载、清洗与增强功能",
  "version": "0.1.0",
  "author": "Yongchao Chen <2938287734@qq.com>",
  "keywords": ["rag", "document", "chunking", "text-processing", "ai"],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@rag-sdk/core": "workspace:*",
    "@rag-sdk/embedding": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "cheerio": "^1.0.0",
    "pdf-parse": "^1.1.0"
  },
  "peerDependenciesMeta": {
    "pdf-parse": {
      "optional": true
    },
    "cheerio": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/pdf-parse": "^1.1.5",
    "cheerio": "^1.2.0",
    "pdf-parse": "^2.4.5"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Miraikou/rag-sdk.git",
    "directory": "packages/document"
  }
}
