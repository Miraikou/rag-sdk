{
  "name": "@ragsdk/evaluation",
  "description": "评测模块，支持检索、生成与端到端评测",
  "version": "0.2.0",
  "author": "Yongchao Chen <2938287734@qq.com>",
  "keywords": [
    "rag",
    "evaluation",
    "benchmark",
    "metrics",
    "ai"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@ragsdk/core": "workspace:*",
    "@ragsdk/llm": "workspace:*",
    "zod": "^4.4.3"
  },
  "devDependencies": {},
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Miraikou/rag-sdk.git",
    "directory": "packages/evaluation"
  }
}
