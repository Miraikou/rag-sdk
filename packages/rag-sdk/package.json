{
  "name": "rag-sdk",
  "version": "0.1.0",
  "description": "通用、模块化、可扩展的 TypeScript RAG SDK",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@rag-sdk/core": "workspace:*",
    "@rag-sdk/document": "workspace:*",
    "@rag-sdk/embedding": "workspace:*",
    "@rag-sdk/indexing": "workspace:*",
    "@rag-sdk/llm": "workspace:*",
    "@rag-sdk/storage": "workspace:*",
    "@rag-sdk/retrieval": "workspace:*",
    "@rag-sdk/generation": "workspace:*",
    "@rag-sdk/evaluation": "workspace:*",
    "@rag-sdk/knowledge-graph": "workspace:*"
  },
  "devDependencies": {}
}
