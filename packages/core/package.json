{
  "name": "@ragsdk/core",
  "description": "RAG SDK 核心模块，提供全局类型定义、Pipeline 编排器与路由",
  "version": "0.2.1",
  "author": "Yongchao Chen <2938287734@qq.com>",
  "keywords": [
    "rag",
    "sdk",
    "pipeline",
    "ai",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src/ --ext .ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {},
  "devDependencies": {},
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Miraikou/rag-sdk.git",
    "directory": "packages/core"
  }
}
